<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Başvuru Formu ekranı paleti (açık mod) -->
    <Color x:Key="FormBackground">#DBC1B2</Color>
    <Color x:Key="FormCard">#FFFFFF</Color>
    <Color x:Key="FormCardBorder">#EAE7F0</Color>
    <Color x:Key="FormTitle">#3D0A06</Color>
    <Color x:Key="FormFieldLabel">#7D200E</Color>
    <Color x:Key="FormFieldBorder">#DCD8E3</Color>
    <Color x:Key="FormFieldText">#2A1708</Color>
    <Color x:Key="FormPlaceholder">#A58570</Color>
    <Color x:Key="FormButtonBackground">#EDEBF1</Color>
    <Color x:Key="FormButtonText">#AD746D</Color>
    <Color x:Key="FormAccent">#C0392B</Color>

    <!-- Silme onayı pop-up'ı (açık mod) -->
    <Color x:Key="FormOverlay">#66000000</Color>
    <Color x:Key="FormConfirmYes">#2E9E5B</Color>
    <Color x:Key="FormConfirmNo">#A58570</Color>

    <!-- Sağ üstte beliren bildirim ve menüdeki çıkış bağlantısı (açık mod) -->
    <Color x:Key="FormToast">#2E9E5B</Color>
    <Color x:Key="FormLogout">#C0392B</Color>

    <!--
      Karanlık mod karşılıkları. Değerler tasarımdaki koyu ekran taslaklarından
      alınmıştır. Her FormXxx anahtarının karşılığı FormXxxDark burada durur;
      FormStyles.xaml ve sayfalardaki her kullanım AppThemeBinding ile bu ikiliyi
      birlikte referans eder, böylece tema değişince MAUI zaten ekrandaki her
      elemanı kendisi günceller ve tek bir sayfa bile yeniden kurulmaz.
    -->
    <Color x:Key="FormBackgroundDark">#1A0A08</Color>
    <Color x:Key="FormCardDark">#2D1411</Color>
    <Color x:Key="FormCardBorderDark">#46301F</Color>
    <Color x:Key="FormTitleDark">#F8D3BB</Color>
    <Color x:Key="FormFieldLabelDark">#AD746D</Color>
    <Color x:Key="FormFieldBorderDark">#57423D</Color>
    <Color x:Key="FormFieldTextDark">#F8D3BB</Color>
    <Color x:Key="FormPlaceholderDark">#A58B85</Color>
    <Color x:Key="FormButtonBackgroundDark">#7D200E</Color>
    <Color x:Key="FormButtonTextDark">#F8D3BB</Color>
    <Color x:Key="FormAccentDark">#FFB4AB</Color>
    <Color x:Key="FormOverlayDark">#CC000000</Color>
    <Color x:Key="FormConfirmYesDark">#2E9E5B</Color>
    <Color x:Key="FormConfirmNoDark">#6B3C37</Color>
    <Color x:Key="FormToastDark">#2E9E5B</Color>
    <Color x:Key="FormLogoutDark">#FFB4AB</Color>
</ResourceDictionary>