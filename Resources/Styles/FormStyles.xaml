<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Uygulamadaki tüm form ve liste ekranlarının ortak görünümü burada tanımlanır.
      Bir alanın rengini veya ölçüsünü değiştirmek istediğinde tek yer burasıdır.
    -->

    <!-- ==================== Form alanları ==================== -->

    <!-- Alan başlığı ile giriş kutusu arasındaki dikey boşluk -->
    <Style x:Key="FieldGroup" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="7" />
    </Style>

    <!-- Alan başlığı: küçük, büyük harf, gri -->
    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormFieldLabel}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>

    <!-- Giriş alanlarının çerçevesi -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource FormFieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource FormCard}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource FormPlaceholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FieldPicker" TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
        <Setter Property="TitleColor" Value="{StaticResource FormPlaceholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Metin rengi başlangıçta saydam; tarih seçilince koyu renge çevrilir -->
    <Style x:Key="FieldDatePicker" TargetType="DatePicker">
        <Setter Property="TextColor" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Format" Value="dd.MM.yyyy" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Tarih alanlarındaki "gg.aa.yyyy" yer tutucusu -->
    <Style x:Key="DatePlaceholder" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormPlaceholder}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <!-- Alan sonundaki ok / takvim çizimleri -->
    <Style x:Key="FieldIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource FormPlaceholder}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <!-- Alan içindeki küçük yükleniyor göstergesi -->
    <Style x:Key="FieldBusyIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource FormAccent}" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ==================== Sayfa iskeleti ==================== -->

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource FormButtonBackground}" />
        <Setter Property="TextColor" Value="{StaticResource FormButtonText}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="PageBusyIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource FormAccent}" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsRunning" Value="False" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ==================== Liste kartları ==================== -->

    <Style x:Key="ListRowLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormFieldLabel}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>

    <Style x:Key="ListRowValue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="ListRowGroup" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
    </Style>

    <!-- Liste boşken görünen metinler -->
    <Style x:Key="EmptyStateTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormPlaceholder}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ==================== Onay pop-up'ı ==================== -->

    <Style x:Key="ConfirmButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
    </Style>

    <!-- Pop-up başlığı ("... emin misiniz?") -->
    <Style x:Key="DialogTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ==================== Bildirim ve bağlantılar ==================== -->

    <!-- Sağ üstte kısa süre görünen yeşil bildirim -->
    <Style x:Key="ToastCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource FormToast}" />
        <Setter Property="Stroke" Value="{StaticResource FormToast}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Margin" Value="14,14,14,0" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="InputTransparent" Value="True" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToastText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Altı çizili, tıklanabilir metin -->
    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FormTitle}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
