<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InternshipMpbile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:InternshipMpbile.Pages"
    xmlns:yerel="clr-namespace:InternshipMpbile.Localization"
    Title="InternshipMpbile"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
    BackgroundColor="{AppThemeBinding Light={StaticResource FormBackground}, Dark={StaticResource FormBackgroundDark}}"
    ForegroundColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
    TitleColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}">

    <!-- Menü satırlarının kendi şablonu. Shell'in varsayılan şablonu yazı rengini
         Shell.UnselectedColor'dan (açık gri) alıyor ve beyaz menü zemininde
         okunmuyordu; renkler burada açıkça verilir. -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid HeightRequest="54"
                  Padding="20,0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">

                <Image Source="{Binding Icon}"
                       HeightRequest="21"
                       WidthRequest="21"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
                       FontFamily="SourceSans3Bold"
                       FontSize="14"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- Görseldeki sol paneldeki amblem ve giriş yapan kullanıcının adı -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="230"
              RowDefinitions="*,Auto,Auto"
              Padding="18,0,18,0"
              BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">

            <Image Source="gsb_logo.png"
                   Aspect="AspectFit"
                   HeightRequest="120"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="0,0,0,14">
                <Label Text="{yerel:Ceviri GİRİŞ YAPAN KULLANICI}"
                       Style="{StaticResource ListRowLabel}"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="KullaniciAdiLabel"
                       TextColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
                       FontFamily="MerriweatherBold"
                       FontSize="15"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <BoxView Grid.Row="2"
                     HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                     Margin="-18,0" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="{yerel:Ceviri Başvuru Formu}" Icon="ic_home.png" Route="basvuruformu">
        <ShellContent ContentTemplate="{DataTemplate pages:BasvuruFormuPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{yerel:Ceviri Başvuru Listesi}" Icon="ic_list.png" Route="basvurulistesi">
        <ShellContent ContentTemplate="{DataTemplate pages:BasvuruListesiPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{yerel:Ceviri Referans Ekleme}" Icon="ic_ref_add.png" Route="referansekleme">
        <ShellContent ContentTemplate="{DataTemplate pages:ReferansEklemePage}" />
    </FlyoutItem>

    <FlyoutItem Title="{yerel:Ceviri Referans Listesi}" Icon="ic_ref_list.png" Route="referanslistesi">
        <ShellContent ContentTemplate="{DataTemplate pages:ReferansListesiPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{yerel:Ceviri Kullanıcılar}" Icon="ic_user.png" Route="kullanicilar">
        <ShellContent ContentTemplate="{DataTemplate pages:KullanicilarPage}" />
    </FlyoutItem>

    <!-- Menünün altındaki dil seçimi ve kırmızı çıkış bağlantısı -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}" />

            <!-- Karanlık mod anahtarı -->
            <Grid HeightRequest="54"
                  Padding="20,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">

                <!-- İçi boş hilal (Material "dark_mode" ikonunun dış hattı):
                     dolgu saydam, yalnızca kenar çizilir. -->
                <Path Data="M12,3
                            C7.03,3 3,7.03 3,12
                            C3,16.97 7.03,21 12,21
                            C16.97,21 21,16.97 21,12
                            C21,11.54 20.96,11.08 20.9,10.64
                            C19.92,12.01 18.32,12.9 16.5,12.9
                            C13.52,12.9 11.1,10.48 11.1,7.5
                            C11.1,5.69 11.99,4.08 13.36,3.1
                            C12.92,3.04 12.46,3 12,3 Z"
                      Stroke="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      Aspect="Uniform"
                      HeightRequest="20"
                      WidthRequest="20"
                      VerticalOptions="Center"
                      InputTransparent="True" />

                <Label Grid.Column="1"
                       Text="{yerel:Ceviri Karanlık Mod}"
                       TextColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
                       FontFamily="MerriweatherBold"
                       FontSize="14"
                       VerticalOptions="Center" />

                <Switch x:Name="KaranlikModAnahtari"
                        Grid.Column="2"
                        Toggled="OnKaranlikModDegisti"
                        VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}" />

            <!-- Dil seçenekleri: aşağıdaki dil satırına dokununca açılır -->
            <VerticalStackLayout x:Name="DilSecenekleri" IsVisible="False">

                <Grid HeightRequest="46"
                      Padding="20,0"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTurkceSecildi" />
                    </Grid.GestureRecognizers>

                    <Border Style="{StaticResource BayrakDairesi}" InputTransparent="True">
                        <Image Source="bayrak_tr.png" Aspect="AspectFill" HeightRequest="24" WidthRequest="24" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="{yerel:Ceviri Türkçe}"
                           Style="{StaticResource DilSecenekMetni}" />
                </Grid>

                <Grid HeightRequest="46"
                      Padding="20,0"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIngilizceSecildi" />
                    </Grid.GestureRecognizers>

                    <Border Style="{StaticResource BayrakDairesi}" InputTransparent="True">
                        <Image Source="bayrak_en.png" Aspect="AspectFill" HeightRequest="24" WidthRequest="24" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="{yerel:Ceviri İngilizce}"
                           Style="{StaticResource DilSecenekMetni}" />
                </Grid>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}" Margin="20,0" />
            </VerticalStackLayout>

            <!-- Seçili dil -->
            <Grid HeightRequest="54"
                  Padding="20,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDilTapped" />
                </Grid.GestureRecognizers>

                <Border Style="{StaticResource BayrakDairesi}" InputTransparent="True">
                    <Image x:Name="AktifBayrak" Aspect="AspectFill" HeightRequest="24" WidthRequest="24" />
                </Border>

                <Label x:Name="AktifDilLabel"
                       Grid.Column="1"
                       TextColor="{AppThemeBinding Light={StaticResource FormTitle}, Dark={StaticResource FormTitleDark}}"
                       FontFamily="MerriweatherBold"
                       FontSize="14"
                       VerticalOptions="Center"
                       InputTransparent="True" />

                <Path x:Name="DilOku"
                      Grid.Column="2"
                      Style="{StaticResource FieldIcon}"
                      Data="M0,0 L5,5 L10,0"
                      HeightRequest="6"
                      WidthRequest="12" />
            </Grid>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}" />

            <Grid HeightRequest="60" Padding="20,0" BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCikisYapTapped" />
                </Grid.GestureRecognizers>

                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Path Data="M9,4 L4,4 L4,20 L9,20 M13,12 L21,12 M18,9 L21,12 L18,15"
                          Stroke="{AppThemeBinding Light={StaticResource FormLogout}, Dark={StaticResource FormLogoutDark}}"
                          StrokeThickness="1.8"
                          Fill="Transparent"
                          Aspect="Uniform"
                          HeightRequest="20"
                          WidthRequest="20"
                          VerticalOptions="Center"
                          InputTransparent="True" />
                    <Label Text="{yerel:Ceviri Çıkış Yap}"
                           TextColor="{AppThemeBinding Light={StaticResource FormLogout}, Dark={StaticResource FormLogoutDark}}"
                           FontFamily="MerriweatherBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
