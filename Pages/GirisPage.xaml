<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InternshipMpbile.Controls"
             xmlns:yerel="clr-namespace:InternshipMpbile.Localization"
             x:Class="InternshipMpbile.Pages.GirisPage"
             Title="{yerel:Ceviri Giriş Yap}"
             BackgroundColor="{AppThemeBinding Light={StaticResource FormBackground}, Dark={StaticResource FormBackgroundDark}}">

    <Grid>

        <ScrollView>
            <!-- Beyaz giriş kartı -->
            <Border Margin="16,28"
                    Padding="22,26,22,24"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Image Source="gsb_logo.png"
                           Aspect="AspectFit"
                           HeightRequest="96"
                           Margin="0,0,0,4" />

                    <Label Text="{yerel:Ceviri Giriş Yap}"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,4" />

                    <controls:MetinAlani x:Name="EpostaAlani"
                                         Baslik="{yerel:Ceviri E-POSTA}"
                                         Klavye="Email" />

                    <controls:ParolaAlani x:Name="ParolaAlani"
                                          Baslik="{yerel:Ceviri PAROLA}" />

                    <Button x:Name="GirisButonu"
                            Text="{yerel:Ceviri Giriş Yap}"
                            Clicked="OnGirisYapClicked"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0" />

                    <Label Text="{yerel:Ceviri Şifremi Unuttum / Şifre almak istiyorum}"
                           Style="{StaticResource LinkLabel}"
                           Margin="0,2,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSifreAlTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Şifre alma pop-up'ı: e-posta sorulur, geçici parola o adrese gider -->
        <Grid x:Name="SifreAlmaOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource FormOverlay}, Dark={StaticResource FormOverlayDark}}">

            <Border Margin="30"
                    Padding="22,24"
                    MaximumWidthRequest="360"
                    BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                    StrokeThickness="1"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="{yerel:Ceviri Şifre Alma}"
                           Style="{StaticResource DialogTitle}" />

                    <Label Text="{yerel:Ceviri Geçici parolanızın gönderileceği e-posta adresini yazınız.}"
                           Style="{StaticResource EmptyStateText}" />

                    <controls:MetinAlani x:Name="SifreAlmaEpostaAlani"
                                         Baslik="{yerel:Ceviri E-POSTA}"
                                         Klavye="Email" />

                    <ActivityIndicator x:Name="GonderiliyorIndicator"
                                       Style="{StaticResource FieldBusyIndicator}"
                                       HorizontalOptions="Center"
                                       IsVisible="False"
                                       IsRunning="False" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="GonderButonu"
                                Text="{yerel:Ceviri Gönder}"
                                Style="{StaticResource ConfirmButton}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FormConfirmYes}, Dark={StaticResource FormConfirmYesDark}}"
                                Clicked="OnSifreGonderClicked" />
                        <Button Grid.Column="1"
                                Text="{yerel:Ceviri Vazgeç}"
                                Style="{StaticResource ConfirmButton}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FormConfirmNo}, Dark={StaticResource FormConfirmNoDark}}"
                                Clicked="OnSifreAlmaVazgecClicked" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
