<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InternshipMpbile.Models"
             x:Class="InternshipMpbile.Pages.ReferansListesiPage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Referans Listesi"
               Style="{StaticResource PageTitle}"
               Margin="0,18,0,10" />

        <RefreshView Grid.Row="1"
                     x:Name="ReferansRefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="ReferansCollectionView"
                            Margin="14,0,14,16">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Henüz referans yok"
                               Style="{StaticResource EmptyStateTitle}" />
                        <Label Text="Referans Ekleme ekranından yeni bir kayıt oluşturabilirsiniz."
                               Style="{StaticResource EmptyStateText}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Referans">
                        <Border Padding="16,14"
                                BackgroundColor="{StaticResource FormCard}"
                                Stroke="{StaticResource FormCardBorder}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#25000000" Offset="0,2" Radius="8" Opacity="0.4" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                <VerticalStackLayout Spacing="9" VerticalOptions="Center">

                                    <VerticalStackLayout Style="{StaticResource ListRowGroup}">
                                        <Label Text="REFERANS TİPİ" Style="{StaticResource ListRowLabel}" />
                                        <Label Text="{Binding Type}" Style="{StaticResource ListRowValue}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Style="{StaticResource ListRowGroup}">
                                        <Label Text="REFERANS ALT TİPİ" Style="{StaticResource ListRowLabel}" />
                                        <Label Text="{Binding Subtype}" Style="{StaticResource ListRowValue}" />
                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                                <!-- Çöp kutusu: silme onayı pop-up'ını açar -->
                                <Border Grid.Column="1"
                                        Padding="9"
                                        BackgroundColor="{StaticResource FormButtonBackground}"
                                        Stroke="{StaticResource FormFieldBorder}"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSilTapped" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M3,5 L17,5 M8,5 L8,3 L12,3 L12,5 M5,5 L5.9,17 L14.1,17 L15,5 M8.4,8 L8.8,14 M11.6,8 L11.2,14"
                                          Stroke="{StaticResource FormAccent}"
                                          StrokeThickness="1.6"
                                          Fill="Transparent"
                                          Aspect="Uniform"
                                          HeightRequest="20"
                                          WidthRequest="20"
                                          InputTransparent="True" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1"
                           x:Name="YukleniyorIndicator"
                           Style="{StaticResource PageBusyIndicator}" />

        <!-- Silme onayı pop-up'ı: liste üzerine binen tam ekran karartma + kart -->
        <Grid x:Name="SilmeOnayiOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="{StaticResource FormOverlay}">

            <Border Margin="30"
                    Padding="22,24"
                    MaximumWidthRequest="340"
                    BackgroundColor="{StaticResource FormCard}"
                    Stroke="{StaticResource FormCardBorder}"
                    StrokeThickness="1"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <Label Text="Referansı Silmek İstediğinizden Emin Misiniz?"
                           TextColor="{StaticResource FormTitle}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Evet"
                                Style="{StaticResource ConfirmButton}"
                                BackgroundColor="{StaticResource FormConfirmYes}"
                                Clicked="OnEvetClicked" />
                        <Button Grid.Column="1"
                                Text="Hayır"
                                Style="{StaticResource ConfirmButton}"
                                BackgroundColor="{StaticResource FormConfirmNo}"
                                Clicked="OnHayirClicked" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
