<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InternshipMpbile.Controls"
             x:Class="InternshipMpbile.Pages.ReferansEklemePage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <ScrollView>
        <!-- Beyaz form kartı -->
        <Border Margin="14,16,14,28"
                Padding="20,22,20,24"
                BackgroundColor="{StaticResource FormCard}"
                Stroke="{StaticResource FormCardBorder}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <Label Text="Referans Ekleme"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,4" />

                <controls:SeciciAlan x:Name="ReferansTipiAlani"
                                     Baslik="REFERANS TİPİ"
                                     SecimDegisti="OnReferansTipiDegisti" />

                <controls:SeciciAlan x:Name="ReferansAltTipiAlani"
                                     Baslik="REFERANS ALT TİPİ"
                                     YerTutucu="Önce referans tipi seçiniz"
                                     Secilebilir="False" />

                <Button Text="Kaydet"
                        Clicked="OnKaydetClicked"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
