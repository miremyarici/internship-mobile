<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InternshipMpbile.Controls"
             xmlns:yerel="clr-namespace:InternshipMpbile.Localization"
             x:Class="InternshipMpbile.Pages.ReferansEklemePage"
             Title=""
             BackgroundColor="{AppThemeBinding Light={StaticResource FormBackground}, Dark={StaticResource FormBackgroundDark}}">

    <Grid>

        <ScrollView>
            <!-- Beyaz form kartı -->
            <Border Margin="14,16,14,28"
                    Padding="20,22,20,24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="{yerel:Ceviri Referans Ekleme}"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,4" />

                    <controls:SeciciAlan x:Name="ReferansTipiAlani"
                                         Baslik="{yerel:Ceviri REFERANS TİPİ}" />

                    <!-- Serbest metin: buraya yazılan değer kaydedildikten sonra
                         Başvuru Formu'nda ilgili tipin açılır listesinde görünür. -->
                    <controls:MetinAlani x:Name="ReferansAltTipiAlani"
                                         Baslik="{yerel:Ceviri REFERANS ALT TİPİ}" />

                    <Button x:Name="KaydetButonu"
                            Text="{yerel:Ceviri Kaydet}"
                            Clicked="OnKaydetClicked"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>
        <!-- Sağ altta sabit duran mesajlaşma butonu -->
        <controls:MesajButonu />

    </Grid>

</ContentPage>
