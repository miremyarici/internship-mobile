<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InternshipMpbile.Pages.ReferansEklemePage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Alan başlığı: küçük, büyük harf, gri -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FormFieldLabel}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="0.8" />
            </Style>

            <!-- Giriş alanlarının çerçevesi -->
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource FormFieldBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{StaticResource FormCard}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldPicker" TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
                <Setter Property="TitleColor" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FieldIcon" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="Fill" Value="Transparent" />
                <Setter Property="Aspect" Value="Uniform" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="FieldGroup" TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="7" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Beyaz form kartı -->
        <Border Margin="14,16,14,28"
                Padding="20,22,20,24"
                BackgroundColor="{StaticResource FormCard}"
                Stroke="{StaticResource FormCardBorder}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <Label Text="Referans Ekleme"
                       TextColor="{StaticResource FormTitle}"
                       FontFamily="OpenSansSemibold"
                       FontSize="19"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4" />

                <!-- REFERANS TİPİ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="REFERANS TİPİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="ReferansTipiPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}"
                                    SelectedIndexChanged="OnReferansTipiChanged" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- REFERANS ALT TİPİ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="REFERANS ALT TİPİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="ReferansAltTipiPicker"
                                    Title="Önce referans tipi seçiniz"
                                    IsEnabled="False"
                                    Style="{StaticResource FieldPicker}" />
                            <ActivityIndicator x:Name="AltTipYukleniyorIndicator"
                                               IsVisible="False"
                                               IsRunning="False"
                                               HeightRequest="18"
                                               WidthRequest="18"
                                               Color="{StaticResource FormAccent}"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="KaydetButton"
                        Text="Kaydet"
                        Clicked="OnKaydetClicked"
                        BackgroundColor="{StaticResource FormButtonBackground}"
                        TextColor="{StaticResource FormButtonText}"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        CornerRadius="6"
                        Padding="26,0"
                        HeightRequest="42"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
