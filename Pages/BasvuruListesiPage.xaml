<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:InternshipMpbile.Models"
             x:Class="InternshipMpbile.Pages.BasvuruListesiPage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Kart içindeki satır başlığı -->
            <Style x:Key="SatirLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FormFieldLabel}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="0.8" />
            </Style>

            <!-- Kart içindeki satır değeri -->
            <Style x:Key="SatirDeger" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="13" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Başvuru Listesi"
               TextColor="{StaticResource FormTitle}"
               FontFamily="OpenSansSemibold"
               FontSize="19"
               HorizontalOptions="Center"
               Margin="0,18,0,10" />

        <RefreshView Grid.Row="1"
                     x:Name="BasvuruRefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="BasvuruCollectionView"
                            Margin="14,0,14,16">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,60" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Henüz başvuru yok"
                               TextColor="{StaticResource FormTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               HorizontalOptions="Center" />
                        <Label Text="Başvuru Formu ekranından yeni bir kayıt oluşturabilirsiniz."
                               TextColor="{StaticResource FormPlaceholder}"
                               FontFamily="OpenSansRegular"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Basvuru">
                        <Border Padding="16,14"
                                BackgroundColor="{StaticResource FormCard}"
                                Stroke="{StaticResource FormCardBorder}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#25000000" Offset="0,2" Radius="8" Opacity="0.4" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="10">

                                <!-- Başlık: proje adı + durum rozeti -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding ProjeAdi}"
                                           TextColor="{StaticResource FormTitle}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1"
                                            Padding="9,3"
                                            BackgroundColor="{StaticResource FormButtonBackground}"
                                            Stroke="{StaticResource FormFieldBorder}"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding BasvuruDurumu}"
                                               TextColor="{StaticResource FormButtonText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="11" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource FormCardBorder}"
                                         HorizontalOptions="Fill" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="9">

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="BAŞVURAN BİRİM" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding BasvuranBirim}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="BAŞVURU DÖNEMİ" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding BasvuruDonemi}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="YAPILAN PROJE" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding BasvuruYapilanProje}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="YAPILAN TÜR" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding BasvuruYapilanTur}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="KATILIMCI TÜRÜ" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding KatilimciTuru}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <Label Text="HİBE TUTARI" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding HibeTutariText}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="2">
                                        <Label Text="BAŞVURU TARİHİ" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding BasvuruTarihiText}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                                        <Label Text="DURUM TARİHİ" Style="{StaticResource SatirLabel}" />
                                        <Label Text="{Binding DurumTarihiText}" Style="{StaticResource SatirDeger}" />
                                    </VerticalStackLayout>

                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1"
                           x:Name="YukleniyorIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="{StaticResource FormAccent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>

</ContentPage>
