<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InternshipMpbile.Pages.BasvuruFormuPage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Alan başlığı: küçük, büyük harf, gri -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FormFieldLabel}" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="0.8" />
            </Style>

            <!-- Giriş alanlarının çerçevesi -->
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource FormFieldBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{StaticResource FormCard}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FieldPicker" TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource FormFieldText}" />
                <Setter Property="TitleColor" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FieldDatePicker" TargetType="DatePicker">
                <Setter Property="TextColor" Value="Transparent" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Format" Value="dd.MM.yyyy" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Tarih alanlarındaki "gg.aa.yyyy" yer tutucusu -->
            <Style x:Key="DatePlaceholder" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="FieldIcon" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource FormPlaceholder}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="Fill" Value="Transparent" />
                <Setter Property="Aspect" Value="Uniform" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="InputTransparent" Value="True" />
            </Style>

            <Style x:Key="FieldGroup" TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="7" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Beyaz form kartı -->
        <Border Margin="14,16,14,28"
                Padding="20,22,20,24"
                BackgroundColor="{StaticResource FormCard}"
                Stroke="{StaticResource FormCardBorder}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <Label Text="Başvuru Formu"
                       TextColor="{StaticResource FormTitle}"
                       FontFamily="OpenSansSemibold"
                       FontSize="19"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4" />

                <!-- PROJE ADI -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="PROJE ADI" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry x:Name="ProjeAdiEntry" Style="{StaticResource FieldEntry}" />
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURAN BİRİM -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURAN BİRİM" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="BasvuranBirimPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURU YAPILAN PROJE -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURU YAPILAN PROJE" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="BasvuruYapilanProjePicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURU YAPILAN TÜR -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURU YAPILAN TÜR" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="BasvuruYapilanTurPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- KATILIMCI TÜRÜ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="KATILIMCI TÜRÜ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="KatilimciTuruPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURU DÖNEMİ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURU DÖNEMİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="BasvuruDonemiPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURU TARİHİ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURU TARİHİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="BasvuruTarihiPlaceholder"
                                   Text="gg.aa.yyyy"
                                   Style="{StaticResource DatePlaceholder}" />
                            <DatePicker x:Name="BasvuruTarihiPicker"
                                        Style="{StaticResource FieldDatePicker}"
                                        DateSelected="OnBasvuruTarihiSelected" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M2,3 L14,3 L14,15 L2,15 Z M2,7 L14,7 M5,1 L5,5 M11,1 L11,5"
                                  HeightRequest="16"
                                  WidthRequest="16" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- BAŞVURU DURUMU -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="BAŞVURU DURUMU" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="BasvuruDurumuPicker"
                                    Title="Seçiniz"
                                    Style="{StaticResource FieldPicker}" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M0,0 L5,5 L10,0"
                                  HeightRequest="6"
                                  WidthRequest="12" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- DURUM TARİHİ -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="DURUM TARİHİ" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="DurumTarihiPlaceholder"
                                   Text="gg.aa.yyyy"
                                   Style="{StaticResource DatePlaceholder}" />
                            <DatePicker x:Name="DurumTarihiPicker"
                                        Style="{StaticResource FieldDatePicker}"
                                        DateSelected="OnDurumTarihiSelected" />
                            <Path Grid.Column="1"
                                  Style="{StaticResource FieldIcon}"
                                  Data="M2,3 L14,3 L14,15 L2,15 Z M2,7 L14,7 M5,1 L5,5 M11,1 L11,5"
                                  HeightRequest="16"
                                  WidthRequest="16" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- HİBE TUTARI -->
                <VerticalStackLayout Style="{StaticResource FieldGroup}">
                    <Label Text="HİBE TUTARI" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry x:Name="HibeTutariEntry"
                               Style="{StaticResource FieldEntry}"
                               Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="KaydetButton"
                        Text="Kaydet"
                        Clicked="OnKaydetClicked"
                        BackgroundColor="{StaticResource FormButtonBackground}"
                        TextColor="{StaticResource FormButtonText}"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        CornerRadius="6"
                        Padding="26,0"
                        HeightRequest="42"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
