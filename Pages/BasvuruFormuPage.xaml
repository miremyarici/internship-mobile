<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InternshipMpbile.Controls"
             xmlns:yerel="clr-namespace:InternshipMpbile.Localization"
             x:Class="InternshipMpbile.Pages.BasvuruFormuPage"
             Title=""
             BackgroundColor="{AppThemeBinding Light={StaticResource FormBackground}, Dark={StaticResource FormBackgroundDark}}">

    <Grid>

        <ScrollView>
            <!-- Beyaz form kartı -->
            <Border Margin="14,16,14,28"
                    Padding="20,22,20,24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="{yerel:Ceviri Başvuru Formu}"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,4" />

                    <controls:MetinAlani x:Name="ProjeAdiAlani"
                                         Baslik="{yerel:Ceviri PROJE ADI}" />

                    <controls:SeciciAlan x:Name="BasvuranBirimAlani"
                                         Baslik="{yerel:Ceviri BAŞVURAN BİRİM}" />

                    <controls:SeciciAlan x:Name="BasvuruYapilanProjeAlani"
                                         Baslik="{yerel:Ceviri BAŞVURU YAPILAN PROJE}" />

                    <controls:SeciciAlan x:Name="BasvuruYapilanTurAlani"
                                         Baslik="{yerel:Ceviri BAŞVURU YAPILAN TÜR}" />

                    <controls:SeciciAlan x:Name="KatilimciTuruAlani"
                                         Baslik="{yerel:Ceviri KATILIMCI TÜRÜ}" />

                    <controls:SeciciAlan x:Name="BasvuruDonemiAlani"
                                         Baslik="{yerel:Ceviri BAŞVURU DÖNEMİ}" />

                    <controls:TarihAlani x:Name="BasvuruTarihiAlani"
                                         Baslik="{yerel:Ceviri BAŞVURU TARİHİ}" />

                    <controls:SeciciAlan x:Name="BasvuruDurumuAlani"
                                         Baslik="{yerel:Ceviri BAŞVURU DURUMU}" />

                    <controls:TarihAlani x:Name="DurumTarihiAlani"
                                         Baslik="{yerel:Ceviri DURUM TARİHİ}" />

                    <controls:MetinAlani x:Name="HibeTutariAlani"
                                         Baslik="{yerel:Ceviri HİBE TUTARI}"
                                         Klavye="Numeric" />

                    <Button x:Name="KaydetButonu"
                            Text="{yerel:Ceviri Kaydet}"
                            Clicked="OnKaydetClicked"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Geçici parolayla giriş yapıldığında formun önünde açılan,
             parola değiştirilmeden kapanmayan pop-up -->
        <Grid x:Name="ParolaDegistirOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource FormOverlay}, Dark={StaticResource FormOverlayDark}}">

            <ScrollView>
                <Border Margin="24,30"
                        Padding="22,24"
                        MaximumWidthRequest="380"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource FormCardBorder}, Dark={StaticResource FormCardBorderDark}}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <Label Text="{yerel:Ceviri Parolayı Değiştir}"
                               Style="{StaticResource DialogTitle}" />

                        <Label Text="{yerel:Ceviri Geçici parolanızla giriş yaptınız. Devam etmek için yeni parolanızı belirleyiniz.}"
                               Style="{StaticResource EmptyStateText}" />

                        <controls:ParolaAlani x:Name="EskiParolaAlani"
                                              Baslik="{yerel:Ceviri ESKİ PAROLA}" />

                        <controls:ParolaAlani x:Name="YeniParolaAlani"
                                              Baslik="{yerel:Ceviri YENİ PAROLA}" />

                        <controls:ParolaAlani x:Name="YeniParolaTekrarAlani"
                                              Baslik="{yerel:Ceviri YENİ PAROLA (TEKRAR)}" />

                        <Button x:Name="ParolaKaydetButonu"
                                Text="{yerel:Ceviri Kaydet}"
                                Clicked="OnParolaKaydetClicked"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,6,0,0" />

                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Sağ üstte 1,5 saniye görünen bildirim -->
        <Border x:Name="BildirimToast" Style="{StaticResource ToastCard}">
            <Label x:Name="BildirimLabel" Style="{StaticResource ToastText}" />
        </Border>

    </Grid>

</ContentPage>
