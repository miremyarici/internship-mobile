<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:InternshipMpbile.Controls"
             x:Class="InternshipMpbile.Pages.BasvuruFormuPage"
             Title=""
             BackgroundColor="{StaticResource FormBackground}">

    <Grid>

        <ScrollView>
            <!-- Beyaz form kartı -->
            <Border Margin="14,16,14,28"
                    Padding="20,22,20,24"
                    BackgroundColor="{StaticResource FormCard}"
                    Stroke="{StaticResource FormCardBorder}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,3" Radius="12" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Başvuru Formu"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,4" />

                    <controls:MetinAlani x:Name="ProjeAdiAlani"
                                         Baslik="PROJE ADI" />

                    <controls:SeciciAlan x:Name="BasvuranBirimAlani"
                                         Baslik="BAŞVURAN BİRİM" />

                    <controls:SeciciAlan x:Name="BasvuruYapilanProjeAlani"
                                         Baslik="BAŞVURU YAPILAN PROJE" />

                    <controls:SeciciAlan x:Name="BasvuruYapilanTurAlani"
                                         Baslik="BAŞVURU YAPILAN TÜR" />

                    <controls:SeciciAlan x:Name="KatilimciTuruAlani"
                                         Baslik="KATILIMCI TÜRÜ" />

                    <controls:SeciciAlan x:Name="BasvuruDonemiAlani"
                                         Baslik="BAŞVURU DÖNEMİ" />

                    <controls:TarihAlani x:Name="BasvuruTarihiAlani"
                                         Baslik="BAŞVURU TARİHİ" />

                    <controls:SeciciAlan x:Name="BasvuruDurumuAlani"
                                         Baslik="BAŞVURU DURUMU" />

                    <controls:TarihAlani x:Name="DurumTarihiAlani"
                                         Baslik="DURUM TARİHİ" />

                    <controls:MetinAlani x:Name="HibeTutariAlani"
                                         Baslik="HİBE TUTARI"
                                         Klavye="Numeric" />

                    <Button Text="Kaydet"
                            Clicked="OnKaydetClicked"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Geçici parolayla giriş yapıldığında formun önünde açılan,
             parola değiştirilmeden kapanmayan pop-up -->
        <Grid x:Name="ParolaDegistirOverlay"
              IsVisible="False"
              BackgroundColor="{StaticResource FormOverlay}">

            <ScrollView>
                <Border Margin="24,30"
                        Padding="22,24"
                        MaximumWidthRequest="380"
                        BackgroundColor="{StaticResource FormCard}"
                        Stroke="{StaticResource FormCardBorder}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,4" Radius="16" Opacity="0.6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <Label Text="Parolayı Değiştir"
                               Style="{StaticResource DialogTitle}" />

                        <Label Text="Geçici parolanızla giriş yaptınız. Devam etmek için yeni parolanızı belirleyiniz."
                               Style="{StaticResource EmptyStateText}" />

                        <controls:ParolaAlani x:Name="EskiParolaAlani"
                                              Baslik="ESKİ PAROLA" />

                        <controls:ParolaAlani x:Name="YeniParolaAlani"
                                              Baslik="YENİ PAROLA" />

                        <controls:ParolaAlani x:Name="YeniParolaTekrarAlani"
                                              Baslik="YENİ PAROLA (TEKRAR)" />

                        <Button x:Name="ParolaKaydetButonu"
                                Text="Kaydet"
                                Clicked="OnParolaKaydetClicked"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,6,0,0" />

                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- Sağ üstte 1,5 saniye görünen bildirim -->
        <Border x:Name="BildirimToast" Style="{StaticResource ToastCard}">
            <Label x:Name="BildirimLabel" Style="{StaticResource ToastText}" />
        </Border>

    </Grid>

</ContentPage>
