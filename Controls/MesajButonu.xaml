<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InternshipMpbile.Controls.MesajButonu"
             HorizontalOptions="End"
             VerticalOptions="End"
             Margin="0,0,18,22">

    <!-- İçi dolu daire; içinde konuşma baloncuğu. Sayfanın kök Grid'inin son
         çocuğu olarak eklenir, böylece içerik kaysa da sağ altta sabit durur. -->
    <Border x:Name="Daire"
            WidthRequest="58"
            HeightRequest="58"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource FormFieldLabel}, Dark={StaticResource FormAccentDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="29" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#55000000" Offset="0,4" Radius="14" Opacity="0.7" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <Path Data="M6,4 L18,4 C19.1,4 20,4.9 20,6 L20,14 C20,15.1 19.1,16 18,16
                    L11.5,16 L7.5,20 L7.5,16 L6,16 C4.9,16 4,15.1 4,14 L4,6
                    C4,4.9 4.9,4 6,4 Z"
              Stroke="{AppThemeBinding Light={StaticResource FormCard}, Dark={StaticResource FormTitle}}"
              StrokeThickness="1.7"
              StrokeLineJoin="Round"
              Fill="Transparent"
              Aspect="Uniform"
              HeightRequest="27"
              WidthRequest="27"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              InputTransparent="True" />
    </Border>

</ContentView>
