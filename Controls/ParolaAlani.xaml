<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InternshipMpbile.Controls.ParolaAlani">

    <VerticalStackLayout Style="{StaticResource FieldGroup}">
        <Label x:Name="BaslikLabel" Style="{StaticResource FieldLabel}" />
        <Border Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto">

                <Entry x:Name="DegerEntry"
                       Style="{StaticResource FieldEntry}"
                       IsPassword="True" />

                <!-- Göz alanı: iki çizim üst üste durur, üstteki saydam buton
                     basılı tutuldukça açık göz görünür ve parola okunur olur. -->
                <Grid Grid.Column="1" WidthRequest="30" HeightRequest="44">

                    <Path x:Name="KapaliGozIkonu"
                          Style="{StaticResource FieldIcon}"
                          Data="M2,12 C6,6 18,6 22,12 C18,18 6,18 2,12 Z
                                M9,12 C9,10.3 10.3,9 12,9 C13.7,9 15,10.3 15,12 C15,13.7 13.7,15 12,15 C10.3,15 9,13.7 9,12 Z
                                M4,20 L20,4"
                          HeightRequest="22"
                          WidthRequest="22"
                          HorizontalOptions="Center" />

                    <Path x:Name="AcikGozIkonu"
                          Style="{StaticResource FieldIcon}"
                          Data="M2,12 C6,6 18,6 22,12 C18,18 6,18 2,12 Z
                                M9,12 C9,10.3 10.3,9 12,9 C13.7,9 15,10.3 15,12 C15,13.7 13.7,15 12,15 C10.3,15 9,13.7 9,12 Z"
                          HeightRequest="22"
                          WidthRequest="22"
                          HorizontalOptions="Center"
                          IsVisible="False" />

                    <Button x:Name="GozButonu"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            CornerRadius="0"
                            Padding="0"
                            HeightRequest="44"
                            WidthRequest="30"
                            MinimumHeightRequest="0"
                            MinimumWidthRequest="0"
                            Pressed="OnGozBasildi"
                            Released="OnGozBirakildi"
                            Clicked="OnGozBirakildi" />

                </Grid>
            </Grid>
        </Border>
    </VerticalStackLayout>

</ContentView>
